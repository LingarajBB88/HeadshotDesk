# Copy to .env and fill in real values. Never commit the real .env.

# --- Core ---
ENV=development
DEBUG=true
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+psycopg://headshotdesk:headshotdesk@localhost:5432/headshotdesk

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=headshotdesk-dev
R2_PUBLIC_BASE_URL=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_SOLO=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_STUDIO=price_...
STRIPE_PRICE_HIBERNATE=price_...
STRIPE_PRICE_AI_OVERAGE=price_...

# --- Postmark (email) ---
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=HeadshotDesk <noreply@headshotdesk.com>

# --- AI providers (only needed for v0.2) ---
REPLICATE_API_TOKEN=
PHOTOROOM_API_KEY=
